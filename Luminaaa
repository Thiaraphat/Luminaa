  <script>
    function switchPage(pageId, btn) {
      document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
      document.getElementById(pageId).classList.add('active');
      document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
      if (btn) btn.classList.add('active');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
    function scrollToBottom(pageId) {
      const shortId = pageId.replace('page', 'p');
      const target = document.getElementById(shortId + '-bottom') || document.getElementById(pageId);
      if (target) target.scrollIntoView({ behavior: 'smooth', block: 'end' });
    }
    function scrollToTop() {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }
  </script>
